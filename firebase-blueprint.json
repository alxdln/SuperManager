{
  "entities": {
    "CustomPlayer": {
      "title": "CustomPlayer",
      "description": "Jucător adăugat manual în baza de date pentru teste și extindere loturi",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unic jucător"
        },
        "name": {
          "type": "string",
          "description": "Numele complet al fotbalistului",
          "maxLength": 100
        },
        "clubId": {
          "type": "string",
          "description": "ID-ul clubului din Superliga",
          "maxLength": 50
        },
        "position": {
          "type": "string",
          "description": "Poziția fotbalistului (GK, DEF, MID, FWD)",
          "enum": ["GK", "DEF", "MID", "FWD"]
        },
        "marketValue": {
          "type": "number",
          "description": "Cota de piață în euro"
        },
        "pointsTotal": {
          "type": "number",
          "description": "Punctajul total acumulat"
        },
        "pointsMatchday": {
          "type": "number",
          "description": "Punctajul din etapa curentă"
        },
        "avatar": {
          "type": "string",
          "description": "URL avatar sau poză fotbalist",
          "maxLength": 500
        },
        "nationality": {
          "type": "string",
          "description": "Naționalitatea fotbalistului",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp creare document"
        }
      },
      "required": ["id", "name", "clubId", "position", "marketValue"]
    }
  },
  "firestore": {
    "/custom_players/{playerId}": {
      "schema": "CustomPlayer",
      "description": "Colecția de jucători personalizați salvați în cloud Firestore"
    }
  }
}
