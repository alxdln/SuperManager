rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow read: if true;
    }

    // User accounts and authentication credentials
    match /users/{userId} {
      allow read, write: if true;
    }

    // Leagues and league configurations
    match /leagues/{leagueId} {
      allow read, write: if true;
    }

    // League members and squad links
    match /league_members/{memberId} {
      allow read, write: if true;
    }

    // League news feed (transfers, joined/left members)
    match /league_news/{newsId} {
      allow read, write: if true;
    }

    // Superliga all players and squads
    match /all_players/{playerId} {
      allow read, write: if true;
    }

    // Custom players for testing and squad additions
    match /custom_players/{playerId} {
      allow read, write: if true;
    }

    // App state, persistent settings and squad test data
    match /app_settings/{docId} {
      allow read, write: if true;
    }

    match /saved_squads/{squadId} {
      allow read, write: if true;
    }
  }
}
